{
	"compilerOptions": {
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"allowJs": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"plugins": [
			{
				"name": "@effect/language-service"
			}
		]
	},
	"exclude": ["dist", "node_modules"]
}
